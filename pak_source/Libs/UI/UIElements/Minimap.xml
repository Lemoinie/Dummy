<UIElements name="Minimap">

  <!-- New standalone HUD element. Auto-registers via the engine's directory
       scan of Libs/UI/UIElements/*.xml, so the always-on hud.gfx is untouched.
       Driven entirely from Scripts/Startup/minimap.lua. -->
  <UIElement name="minimap" lazy_update="0" mouseevents="0" cursor="0">

    <GFx file="minimap.gfx" layer="22">
      <Constraints>
        <!-- fullscreen keeps the element sized/placed as before (fills the screen); the
             screen_resize flag corrects the pixel aspect so the circle stays round on
             ultrawide instead of stretching. "dynamic" shrank the whole movie. -->
        <Align mode="fullscreen" scale="1" screen_resize="CorrectAspectRatio" />
      </Constraints>
    </GFx>

    <functions>

      <!-- one-time / on-change configuration -->
      <function name="MinimapConfig" funcname="fc_minimapConfig">
        <param name="Size"      desc="viewport size in px"             type="int" />
        <param name="Shape"     desc="0 circle, 1 square"              type="int" />
        <param name="MapAlpha"  desc="map opacity 0..100"             type="int" />
        <param name="RotateMap" desc="1 rotate map, 0 north-up"        type="bool" />
        <param name="Corner"    desc="0 TL, 1 TR, 2 BL, 3 BR"          type="int" />
        <param name="Margin"    desc="px from screen edges"            type="int" />
        <param name="IconSize"  desc="POI icon size px (0 = dots)"     type="int" />
        <param name="ShowPlayer" desc="1 show player arrow, 0 hide"    type="bool" />
        <param name="FrameStyle" desc="0 main Apse, 1 thin HUD, 2 legacy, 3 off" type="int" />
        <param name="NorthStyle" desc="0 Apse leaf N, 1 map pennant N, 2 legacy, 3 off" type="int" />
        <param name="Aspect"    desc="UI horizontal scale % (ultrawide oval fix)" type="int" />
      </function>

      <!-- choose / load the base map for the current level -->
      <function name="MinimapSetMap" funcname="fc_minimapSetMap">
        <param name="LevelName" desc="trosecko / kutnohorsko / klaster" type="string" />
        <param name="Hires"     desc="1 high-detail, 0 stock tile"      type="bool" />
        <param name="ImgW"      desc="map image width px (tile grid)"   type="int" />
        <param name="ImgH"      desc="map image height px (tile grid)"  type="int" />
        <param name="Tile"      desc="tile size px"                     type="int" />
        <param name="Cols"      desc="tile grid columns"                type="int" />
        <param name="Rows"      desc="tile grid rows"                   type="int" />
      </function>

      <!-- per-tick: player UV on the map image + zoom + heading -->
      <function name="MinimapUpdate" funcname="fc_minimapUpdate">
        <param name="Pu"      desc="player U on map 0..1"              type="float" />
        <param name="Pv"      desc="player V on map 0..1"              type="float" />
        <param name="Radius"  desc="world metres centre->rim"          type="float" />
        <param name="CropW"   desc="world metres the map spans (X)"    type="float" />
        <param name="Heading" desc="player heading degrees"            type="float" />
      </function>

      <!-- per-frame heading only (60fps rotation smoothing); pan/markers stay on MinimapUpdate -->
      <function name="MinimapHeading" funcname="fc_minimapHeading">
        <param name="Heading" desc="player heading degrees"           type="float" />
      </function>

      <!-- apply the markers pushed into g_MinimapMarkersA; Icons = "|"-delimited POI icon names -->
      <function name="MinimapApplyMarkers" funcname="fc_minimapApplyMarkers">
        <param name="Icons" desc="'|'-delimited POI icon names ('' = dot)" type="string" />
      </function>

      <function name="MinimapShow" funcname="fc_minimapShow">
        <param name="Visible" desc="1 show, 0 hide"                    type="bool" />
      </function>

      <!-- overall brightness of the whole minimap (map+markers+frame); used for auto night-dimming -->
      <function name="MinimapDim" funcname="fc_minimapDim">
        <param name="Pct" desc="overall brightness 0..100 (100 = full)" type="int" />
      </function>

      <!-- settings panel -->
      <function name="UiShow" funcname="fc_uiShow">
        <param name="Visible" desc="1 show, 0 hide"                    type="bool" />
      </function>
      <function name="UiRender" funcname="fc_uiRender">
        <param name="Sel"  desc="selected row index (0-based)"         type="int" />
        <param name="Rows" desc="'|'-delimited label=value rows"       type="string" />
        <param name="Desc" desc="description of the selected item"     type="string" />
      </function>

      <!-- on-screen warning if the native companion (.asi) isn't loaded ('' = hide) -->
      <function name="Notice" funcname="fc_notice">
        <param name="Text" desc="warning text, '' hides it"           type="string" />
      </function>

      <!-- in-game time shown on the plaque mounted on the minimap frame; '' hides it -->
      <function name="MinimapClock" funcname="fc_minimapClock">
        <param name="Text" desc="formatted time e.g. '14:32', '' hides it" type="string" />
      </function>

    </functions>

    <arrays>
      <!-- flat: [count, u0,v0,type0, u1,v1,type1, ...] -->
      <array name="MinimapMarkers" varname="g_MinimapMarkersA" />
    </arrays>

  </UIElement>

</UIElements>
