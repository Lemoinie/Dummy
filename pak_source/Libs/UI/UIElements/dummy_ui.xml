<UIElements name="DummyUI">
  <UIElement name="dummy_ui" lazy_update="0" mouseevents="0" cursor="0">
    <GFx file="minimap.gfx" layer="22">
      <Constraints>
        <Align mode="fullscreen" scale="1" screen_resize="CorrectAspectRatio" />
      </Constraints>
    </GFx>
    <functions>
      <function name="UiShow" funcname="fc_uiShow">
        <param name="Visible" desc="1 show, 0 hide" type="bool" />
      </function>
      <function name="UiRender" funcname="fc_uiRender">
        <param name="Sel" desc="selected row index (0-based)" type="int" />
        <param name="Rows" desc="'|'-delimited label=value rows" type="string" />
        <param name="Desc" desc="description of the selected item" type="string" />
      </function>
    </functions>
  </UIElement>
</UIElements>
