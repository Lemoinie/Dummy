<?xml version="1.0" encoding="utf-8"?>
<!--
    Dummy Mod – Custom ActionMap
    ─────────────────────────────
    This file goes inside your .pak at:
      Libs/Config/defaultProfile.xml

    The game merges ActionMaps from this path.
    Using a unique map name ("dummy_spawner") avoids
    collisions with vanilla or third-party maps.
-->
<ActionMaps>
    <ActionMap name="dummy_spawner">
        <!-- Spawn / despawn toggle -->
        <action name="dummy_spawn_toggle"
                onPress="1"
                keyboard="/" />

        <!-- Cycle armor preset forward -->
        <action name="dummy_preset_next"
                onPress="1"
                keyboard="." />

        <!-- Cycle armor preset backward -->
        <action name="dummy_preset_prev"
                onPress="1"
                keyboard="," />
    </ActionMap>
</ActionMaps>
