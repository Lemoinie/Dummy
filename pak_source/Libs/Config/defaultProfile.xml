<?xml version="1.0" encoding="utf-8"?>
<!--
    Dummy Mod – Custom ActionMap
    ─────────────────────────────
-->
<ActionMaps>
    <ActionMap name="dummy_spawner">
        <!-- Spawn / despawn toggle (Default: /) -->
        <action name="dummy_spawn_toggle"
                onPress="1"
                keyboard="/" />

        <!-- Open / toggle Configuration Menu (Default: F3) -->
        <action name="dummy_menu_toggle"
                onPress="1"
                keyboard="f3" />

        <!-- Cycle armor preset forward -->
        <action name="dummy_preset_next"
                onPress="1"
                keyboard="." />

        <!-- Cycle armor preset backward -->
        <action name="dummy_preset_prev"
                onPress="1"
                keyboard="," />
    </ActionMap>
</ActionMaps>
