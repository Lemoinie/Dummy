<?xml version="1.0" encoding="us-ascii"?>
<BehaviorTrees>
    <!-- Dummy training target scheduler: simply stands still forever.
         No flee, no combat reaction, no follow.  Just idles in place. -->
    <BehaviorTree name="onUpdate" is_function="0">
        <Variables>
            <Variable name="playerWUID"    type="_wuid" values="" isPersistent="0" form="single" />
            <Variable name="dialogRequest" type="dialogModule:onDialogRequest" values="" isPersistent="0" form="single" />
        </Variables>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1">
                <SuppressFailure>
                    <Loop count="-1">
                        <Wait duration="'10s'" timeType="GameTime" doFail="false" variation="'5s'" />
                    </Loop>
                </SuppressFailure>
            </Behavior>
        </Root>
    </BehaviorTree>
</BehaviorTrees>
