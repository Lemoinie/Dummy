<?xml version="1.0" encoding="utf-8"?>
<kcd_mod>
  <info>
    <name>Dummy</name>
    <modid>dummy</modid>
    <description>Spawns a neutral NPC dummy in front of the player and lets you swap armor presets on it via keybinds.</description>
    <author>Lemoinie</author>
    <version>1.0.0</version>
    <created_on>2026-08-02</created_on>
  </info>
  <supports>
    <kcd_version>1.*</kcd_version>
  </supports>
</kcd_mod>
